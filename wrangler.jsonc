{
	"name": "questplus",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"pages_build_output_dir": ".svelte-kit/cloudflare",
	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "questplus-midia" }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "questplus",
			"database_id": "a56ca2c0-c7b8-4c19-8322-da76fa97cdc1",
			"migrations_dir": "migrations"
		}
	]
}
